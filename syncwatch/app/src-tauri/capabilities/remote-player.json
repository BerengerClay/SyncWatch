{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-player-access",
  "description": "Autorise YouTube et TF1+ à envoyer des rapports de lecture via l'IPC natif.",
  "windows": ["main"],
  "webviews": ["player"],
  "remote": {
    "urls": [
      "https://youtube.com",
      "https://*.youtube.com",
      "https://*.googlevideo.com",
      "https://*.tf1.fr"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "allow-playback-commands"
  ]
}
